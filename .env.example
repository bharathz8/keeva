# ==============================================================
# Relationship Intelligence AI (Keeva) - Environment Template
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================

# --------------------------------------------------------------
# Frontend (Client Configuration)
# --------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# --------------------------------------------------------------
# Backend AI & Long-Term Memory
# --------------------------------------------------------------
# Google Gemini API Key (Cloud fallback & LangGraph reasoning)
GEMINI_API_KEY=your_gemini_api_key

# Mem0 API Key (Vector-indexed semantic memory)
MEM0_API_KEY=your_mem0_api_key

# Firebase Admin Service Account (Path to JSON credential file)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your_project_id

# --------------------------------------------------------------
# AI Consequence & Pause Thresholds
# --------------------------------------------------------------
CONSEQUENCE_THRESHOLD=0.65
EMOTIONAL_INTENSITY_THRESHOLD=0.60

# --------------------------------------------------------------
# Server & Security Configuration
# --------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
USE_MOCK_AUTH_IN_DEV=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
